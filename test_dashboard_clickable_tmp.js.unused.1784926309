const path = require("path");
const { spawn } = require("child_process");
const { JSDOM } = require("jsdom");
const fetch = require("node-fetch");

const APPDIR = "/sessions/sweet-ecstatic-clarke/mnt/PadmasriTravels_Supervisor_app";
const PORT = 5935;
const API = `http://127.0.0.1:${PORT}`;

function wait(ms) { return new Promise(r => setTimeout(r, ms)); }
let allOk = true;
function check(label, cond, extra) {
  console.log((cond ? "OK  " : "FAIL") + " - " + label + (extra ? " :: " + JSON.stringify(extra) : ""));
  if (!cond) allOk = false;
}
async function jf(url, opts) {
  const res = await fetch(url, opts);
  let data = null;
  try { data = await res.json(); } catch (e) {}
  return { res, data };
}
async function loginStaff(identifier, tempPassword) {
  let { res, data } = await jf(`${API}/api/login`, {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ identifier, password: tempPassword }),
  });
  if (!res.ok) throw new Error("login failed: " + JSON.stringify(data));
  let token = data.token;
  if (data.user && data.user.mustChangePassword) {
    const newPw = "NewPass!" + Math.floor(Math.random() * 100000) + "9";
    const cp = await jf(`${API}/api/change-password`, {
      method: "POST", headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
      body: JSON.stringify({ currentPassword: tempPassword, newPassword: newPw }),
    });
    if (!cp.res.ok) throw new Error("change-password failed: " + JSON.stringify(cp.data));
  }
  return token;
}
function auth(token) { return { Authorization: "Bearer " + token, "Content-Type": "application/json" }; }

(async () => {
  const dataFile = path.join(APPDIR, "data", "data.json");
  try { require("fs").renameSync(dataFile, dataFile + ".away." + Date.now()); } catch (e) {}
  const env = Object.assign({}, process.env, { PORT: String(PORT) });
  delete env.AI_TEST_STUB;
  delete env.ANTHROPIC_API_KEY;
  const server = spawn("node", [path.join(APPDIR, "server.js")], { cwd: APPDIR, env });
  server.stderr.on("data", (d) => console.error("SERVER ERR:", d.toString()));
  await wait(1500);

  const ownerToken = await loginStaff("vamshi.reddy@padmasritravels.in", "Padmasri@9999");

  // Seed data has no approved expenses yet, so "top_expense" would never
  // appear - submit and approve one so that insight (and its click-through)
  // can actually be exercised.
  const { data: vehData } = await jf(`${API}/api/vehicles`, { headers: auth(ownerToken) });
  const expenseVehicle = vehData[0];
  const TINY_PNG = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII=";
  const { data: newExpense } = await jf(`${API}/api/expenses`, {
    method: "POST", headers: auth(ownerToken),
    body: JSON.stringify({ amount: 5000, category: "Fuel", description: "Test top-expense seed", vehicleId: expenseVehicle.id, bill: TINY_PNG }),
  });
  await jf(`${API}/api/expenses/${newExpense.id}/decide`, { method: "PATCH", headers: auth(ownerToken), body: JSON.stringify({ status: "approved" }) });

  // Inspect the raw insights + mileage-summary shape first, before asserting on the UI.
  const { data: insightsData } = await jf(`${API}/api/smart-assistant/insights`, { headers: auth(ownerToken) });
  check("insights include type field on every insight", insightsData.insights.every(i => !!i.type), insightsData.insights);
  const idleInsight = insightsData.insights.find(i => i.type === "idle");
  const topExpenseInsight = insightsData.insights.find(i => i.type === "top_expense");
  const goodInsight = insightsData.insights.find(i => i.type === "docs_ok" || i.type === "fleet_ok");
  check("an 'idle' insight is present (seed data has idle vehicles)", !!idleInsight, insightsData.insights);
  check("a 'top_expense' insight is present with a reg", !!(topExpenseInsight && topExpenseInsight.reg), topExpenseInsight);

  const { data: mileageData } = await jf(`${API}/api/dashboard/mileage-summary`, { headers: auth(ownerToken) });
  const worstReg = (mileageData.categories || []).flatMap(c => c.worst || [])[0];

  const html = await (await fetch(`${API}/`)).text();
  const dom = new JSDOM(html, {
    url: `${API}/`, runScripts: "dangerously", resources: "usable", pretendToBeVisual: true,
    beforeParse(win) {
      win.fetch = (u, o) => fetch(u.startsWith("http") ? u : `${API}${u}`, o);
      win.localStorage.setItem("fleetAuthToken", ownerToken);
    },
  });
  const win = dom.window;
  const errs = [];
  win.addEventListener("error", (e) => errs.push(e.error ? e.error.stack || e.error.message : e.message));
  await wait(900);
  await win.eval(`switchTab('dashboard')`);
  await wait(1200); // let the async Fleet Insights fetch land

  // ---------- 1. Fleet Insights card: clickable "idle" card navigates to the idle list ----------
  const insightCards = () => Array.from(win.document.querySelectorAll(".ai-insight-card"));
  const idleCard = insightCards().find(c => /idle today/.test(c.textContent));
  check("an idle Fleet Insight card rendered", !!idleCard, insightCards().map(c=>c.textContent.slice(0,40)));
  check("the idle insight card has a pointer cursor (clickable)", idleCard && idleCard.style.cursor === "pointer", idleCard && idleCard.getAttribute("style"));
  idleCard.click();
  await wait(500);
  check("clicking the idle insight card navigates to the Idle vehicles list", /Idle vehicles today/i.test(win.document.querySelector("h1.page-title").textContent), win.document.querySelector("h1.page-title").textContent);

  // ---------- 2. Idle vehicle list: each row is clickable and opens that vehicle's status page ----------
  const idleRow = win.document.querySelector("table tr[onclick]");
  check("idle list has at least one clickable vehicle row", !!idleRow, win.document.body.innerHTML.slice(0,200));
  const clickedReg = idleRow.querySelector("td b").textContent.trim();
  idleRow.click();
  await wait(500);
  const statusTitle = win.document.querySelector("h1.page-title").textContent;
  check("clicking an idle row opens that vehicle's Today's Status page", statusTitle.includes(clickedReg) && /Today's Status/i.test(statusTitle), statusTitle);

  // ---------- 3. Vehicle status page shows an action (or explicitly says nothing to act on) ----------
  const actionCardText = Array.from(win.document.querySelectorAll(".card")).find(c => c.querySelector(".section-title") && c.querySelector(".section-title").textContent.trim() === "Action");
  check("vehicle status page has an Action card", !!actionCardText, win.document.body.innerHTML.slice(0,300));
  check("Action card explains the pending state (idle vehicle with no submission yet)", /hasn't submitted|waiting on your sign-off|already approved|waiting on the supervisor/i.test(actionCardText.textContent), actionCardText.textContent);

  // ---------- 4. Back to dashboard, click the standalone Idle vehicles card row too ----------
  await win.eval(`goto('home')`);
  await wait(600);
  const idleCardHeading = Array.from(win.document.querySelectorAll(".section-title")).find(h => /^Idle vehicles today/.test(h.textContent));
  check("standalone Idle vehicles today card is present on the dashboard", !!idleCardHeading, null);
  const idleTableRow = idleCardHeading.closest(".card").querySelector("table tr[onclick]");
  check("standalone Idle vehicles today card rows are clickable", !!idleTableRow, null);
  idleTableRow.click();
  await wait(500);
  check("clicking a row in the standalone Idle vehicles card also opens the vehicle status page", /Today's Status/i.test(win.document.querySelector("h1.page-title").textContent), win.document.querySelector("h1.page-title").textContent);

  // ---------- 5. Fleet Insight card for top_expense navigates to that vehicle's Expenditure History ----------
  await win.eval(`goto('home')`);
  await wait(600);
  const topExpenseCard = insightCards().find(c => /Highest spend/.test(c.textContent));
  check("a 'Highest spend' insight card rendered", !!topExpenseCard, null);
  topExpenseCard.click();
  await wait(600);
  const topExpTitle = win.document.querySelector("h1.page-title").textContent;
  check("clicking the top-expense insight opens that vehicle's Expenditure History", /Expenditure History/i.test(topExpTitle) && topExpTitle.includes(expenseVehicle.reg), topExpTitle);

  // ---------- 6. 'Good' insights (nothing to fix) are NOT clickable ----------
  await win.eval(`goto('home')`);
  await wait(600);
  const goodCard = insightCards().find(c => /Documents in order|Full fleet activity/.test(c.textContent));
  if (goodCard) {
    check("a 'good' (non-actionable) insight card has no pointer cursor", goodCard.style.cursor !== "pointer", goodCard.getAttribute("style"));
    check("a 'good' insight card says there's nothing to act on", /Nothing to act on right now/.test(goodCard.textContent), goodCard.textContent);
  } else {
    console.log("OK  - no 'good' insight present in this seed data to check (skipped, not a failure)");
  }

  // ---------- 7. Mileage worst-performer rows are clickable when mileage data exists ----------
  if (worstReg) {
    const mileageRow = Array.from(win.document.querySelectorAll("table tr[onclick]")).find(tr => tr.textContent.includes(worstReg.reg));
    check("a mileage worst-performer row is clickable", !!mileageRow, worstReg);
    if (mileageRow) {
      mileageRow.click();
      await wait(600);
      check("clicking a mileage worst-performer row opens Expenditure History with Mileage expanded", /Expenditure History/i.test(win.document.querySelector("h1.page-title").textContent) && /Mileage History/i.test(win.document.body.textContent), win.document.querySelector("h1.page-title").textContent);
    }
  } else {
    console.log("OK  - no mileage worst-performer rows in this seed data to check (skipped, not a failure)");
  }

  check("no runtime JS errors across the whole clickable-dashboard flow", errs.length === 0, errs);

  server.kill();
  console.log(allOk ? "\nALL CHECKS PASSED" : "\nSOME CHECKS FAILED");
  process.exit(allOk ? 0 : 1);
})();
