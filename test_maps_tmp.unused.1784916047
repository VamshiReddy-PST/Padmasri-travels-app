const path = require("path");
const { spawn } = require("child_process");
const { JSDOM } = require("jsdom");
const fetch = require("node-fetch");

const APPDIR = "/sessions/sweet-ecstatic-clarke/mnt/PadmasriTravels_Supervisor_app";
const PORT = 5908;
const API = `http://127.0.0.1:${PORT}`;

function wait(ms) { return new Promise(r => setTimeout(r, ms)); }
let allOk = true;
function check(label, cond, extra) {
  console.log((cond ? "OK  " : "FAIL") + " - " + label + (extra ? " :: " + JSON.stringify(extra) : ""));
  if (!cond) allOk = false;
}
async function jf(url, opts) {
  const res = await fetch(url, opts);
  let data = null;
  try { data = await res.json(); } catch (e) {}
  return { res, data };
}
async function loginStaff(identifier, tempPassword) {
  let { res, data } = await jf(`${API}/api/login`, {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ identifier, password: tempPassword }),
  });
  if (!res.ok) throw new Error("login failed: " + JSON.stringify(data));
  let token = data.token;
  if (data.user && data.user.mustChangePassword) {
    const newPw = "NewPass!" + Math.floor(Math.random() * 100000) + "9";
    const cp = await jf(`${API}/api/change-password`, {
      method: "POST", headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
      body: JSON.stringify({ currentPassword: tempPassword, newPassword: newPw }),
    });
    if (!cp.res.ok) throw new Error("change-password failed: " + JSON.stringify(cp.data));
  }
  return token;
}

(async () => {
  const dataFile = path.join(APPDIR, "data", "data.json");
  try { require("fs").renameSync(dataFile, dataFile + ".away." + Date.now()); } catch (e) {}
  const env = Object.assign({}, process.env, { PORT: String(PORT) });
  const server = spawn("node", [path.join(APPDIR, "server.js")], { cwd: APPDIR, env });
  server.stderr.on("data", (d) => console.error("SERVER ERR:", d.toString()));
  await wait(1500);

  const ownerToken = await loginStaff("vamshi.reddy@padmasritravels.in", "Padmasri@9999");

  // Allocate a trip with pickup/drop text
  const vehiclesResp = await jf(`${API}/api/vehicles`, { headers: { Authorization: "Bearer " + ownerToken } });
  const vehicleWithDriver = vehiclesResp.data.find(v => v.id === "v1") || vehiclesResp.data.find(v => v.driverId);
  check("found seed vehicle v1 (driver Mahesh) for trip + location test", !!vehicleWithDriver && vehicleWithDriver.driverId === "d_mahesh", vehicleWithDriver);
  const { res: tripRes, data: tripData } = await jf(`${API}/api/trips`, {
    method: "POST", headers: { "Content-Type": "application/json", Authorization: "Bearer " + ownerToken },
    body: JSON.stringify({ vehicleId: vehicleWithDriver.id, date: "2026-07-25", scheduledTime: "09:00 AM", pickupPoint: "Gachibowli Client Office", dropPoint: "Miyapur Residence", notes: "Maps test trip" }),
  });
  check("trip created", tripRes.ok, tripData);

  // Driver login + location ping so driverLocationLogs gets populated.
  // Seed driver Mahesh (d_mahesh, phone 9000000001, default PIN 1234) is
  // assigned to vehicle v1 - the same seed driver used in the earlier
  // odometer-verification test, so these credentials are known-good.
  const { data: dLogin } = await jf(`${API}/api/driver-auth/login`, {
    method: "POST", headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ phone: "9000000001", pin: "1234" }),
  });
  const driverToken = dLogin && dLogin.token;
  check("driver logged in for location-ping test", !!driverToken, dLogin);
  if (driverToken) {
    const { res: pingRes } = await jf(`${API}/api/driver-auth/location-ping`, {
      method: "POST", headers: { "Content-Type": "application/json", Authorization: "Bearer " + driverToken },
      body: JSON.stringify({ lat: 17.4401, lng: 78.3489 }),
    });
    check("location ping accepted", pingRes.ok);
  }

  // ---------- backend: GET /api/driver-shifts includes lastLocation ----------
  const { res: shiftsRes, data: shifts } = await jf(`${API}/api/driver-shifts`, { headers: { Authorization: "Bearer " + ownerToken } });
  check("driver-shifts endpoint returns 200", shiftsRes.ok);
  const shiftForDriver = (shifts || []).find(s => s.driverId === vehicleWithDriver.driverId);
  check("shift row for our driver includes a lastLocation with the pinged coordinates", shiftForDriver && shiftForDriver.lastLocation && shiftForDriver.lastLocation.lat === 17.4401 && shiftForDriver.lastLocation.lng === 78.3489 && shiftForDriver.lastLocation.source === "live", shiftForDriver && shiftForDriver.lastLocation);

  // ---------- frontend: Trips screen renders Maps links for pickup/drop ----------
  const html = await (await fetch(`${API}/`)).text();
  const dom = new JSDOM(html, {
    url: `${API}/`, runScripts: "dangerously", resources: "usable", pretendToBeVisual: true,
    beforeParse(win) {
      win.fetch = (u, o) => fetch(u.startsWith("http") ? u : `${API}${u}`, o);
      win.URL.createObjectURL = () => "blob:mock";
      win.URL.revokeObjectURL = () => {};
      win.localStorage.setItem("fleetAuthToken", ownerToken);
    },
  });
  const win = dom.window;
  const errs = [];
  win.addEventListener("error", (e) => errs.push(e.error ? e.error.stack || e.error.message : e.message));
  await wait(800);
  await win.eval(`switchTab('trips')`);
  await wait(600);
  let body = win.document.body.innerHTML;
  check("Trips screen: no runtime JS errors", errs.length === 0, errs);
  check("Trips screen shows pickup point text", body.includes("Gachibowli Client Office"));
  check("Trips screen wraps pickup point in a Maps deep-link", body.includes("maps/search/?api=1") && body.includes(encodeURIComponent("Gachibowli Client Office")));
  check("Trips screen wraps drop point in a Maps deep-link", body.includes(encodeURIComponent("Miyapur Residence")));

  await win.eval(`switchTab('odometer_verify')`);
  await wait(700);
  body = win.document.body.innerHTML;
  check("Odometer Verification screen: no runtime JS errors", errs.length === 0, errs);
  check("Odometer Verification screen shows a driver location line", body.includes("Location ("));
  check("Odometer Verification screen wraps driver's last location in a Maps deep-link", body.includes("maps/search/?api=1") && body.includes("17.4401,78.3489"));

  server.kill();
  console.log(allOk ? "\nALL CHECKS PASSED" : "\nSOME CHECKS FAILED");
  process.exit(allOk ? 0 : 1);
})();
